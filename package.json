{
  "name": "vlm-diff-eval",
  "version": "0.1.0",
  "description": "Research prototype: deterministic detection + VLM classification for fine-grained UI screenshot diffing",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/**/*.test.js",
    "postbuild": "cp -r src/dataset/fixtures dist/dataset/fixtures",
    "dataset:gen": "npm run build && node dist/dataset/generate.js",
    "eval:run": "npm run build && node dist/eval/run.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "openai": "^4.77.0",
    "playwright": "^1.62.1",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.5",
    "@types/pngjs": "^6.0.5"
  }
}
